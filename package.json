{
  "name": "qelcare-patient-mobile",
  "version": "1.0.3",
  "private": true,
  "description": "Patient-only QELCare mobile app packaged with Capacitor for Android APK builds; regenerated against qelcaresql-V7 full dump.",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "baseline-browser-mapping": "^2.10.35",
    "lucide-react": "^1.46.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "@babel/traverse": "7.29.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "typescript": "5.9.3",
    "vite": "^7.2.4"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "eslint src scripts vite.config.js --ext .js,.jsx,.mjs,.cjs",
    "typecheck": "tsc --noEmit",
    "check:contracts": "node scripts/check-ui-contracts.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "cap:add:android": "npm run build && npx cap add android",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:add:ios": "npm run build && npx cap add ios",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "apk:debug": "npm run cap:sync:android && cd android && ./gradlew assembleDebug",
    "apk:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  }
}
