<?xml version="1.0" encoding="utf-8"?>
<!-- Website Folio paper and the QELCare Portal Plus mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/qelcare_paper" />
        </shape>
    </item>
    <item android:width="108dp" android:height="108dp" android:gravity="center">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/qelcare_pine" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:drawable="@drawable/qelcare_brand_mark" />
        </layer-list>
    </item>
</layer-list>
